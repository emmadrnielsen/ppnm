
set terminal svg size 1200,700 background "white"
set output "qspline_plot.svg"

set xlabel "z"
set ylabel "value"
set grid
set key outside

plot \
    "data_B.txt" using 1:2 with lines title "quadratic spline", \
    "data_B.txt" using 1:5 with lines title "cos(z)", \
    "data_B.txt" using 1:3 with lines title "quadratic spline derivative", \
    "data_B.txt" using 1:6 with lines title "-sin(z)", \
    "data_B.txt" using 1:4 with lines title "quadratic spline integral", \
    "data_B.txt" using 1:7 with lines title "sin(z)"