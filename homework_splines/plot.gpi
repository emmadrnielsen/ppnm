set terminal svg size 1200,600 background "white"
set output "plot.svg"

set xlabel "z"
set ylabel "value"
set grid
set key outside

plot \
    "data_A.txt" using 1:2 with lines title "linear spline", \
    "data_A.txt" using 1:4 with lines title "cos(z)", \
    "data_A.txt" using 1:3 with lines title "integral of linear spline", \
    "data_A.txt" using 1:5 with lines title "sin(z)"