set terminal svg size 1200,600 background "white"
set output "harmonic_oscillator.svg"

set xlabel "x"
set ylabel "value"
set grid
set key outside

plot \
    "data.txt" using 1:2 with linespoints title "u numeric", \
    "data.txt" using 1:3 with lines title "cos(x)", \
    "data.txt" using 1:4 with linespoints title "u' numeric", \
    "data.txt" using 1:5 with lines title "-sin(x)"