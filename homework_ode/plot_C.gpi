set terminal svg size 700,700 background "white"
set output "three_body_C.svg"

set xlabel "x"
set ylabel "y"
set size ratio -1
set grid
set key outside

plot \
    "three_body_C.txt" using 2:3 with lines title "body 1", \
    "three_body_C.txt" using 4:5 with lines title "body 2", \
    "three_body_C.txt" using 6:7 with lines title "body 3"