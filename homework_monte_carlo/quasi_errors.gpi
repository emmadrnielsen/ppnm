set terminal svg size 1000,700 background "white"
set output "quasi_errors.svg"

set xlabel "N"
set ylabel "error"
set logscale x
set logscale y
set grid
set key outside

plot \
    "quasi_errors.txt" using 1:2 with linespoints title "plain actual error", \
    "quasi_errors.txt" using 1:3 with linespoints title "quasi actual error", \
    "quasi_errors.txt" using 1:4 with linespoints title "plain estimated error", \
    "quasi_errors.txt" using 1:5 with linespoints title "quasi estimated error"