set terminal svg size 1000,700 background "white"
set output "circle_errors.svg"

set xlabel "N"
set ylabel "error"
set logscale x
set logscale y
set grid
set key outside

plot \
    "circle_errors.txt" using 1:3 with linespoints title "estimated error", \
    "circle_errors.txt" using 1:4 with linespoints title "actual error", \
    "circle_errors.txt" using 1:5 with linespoints title "1/sqrt(N)"