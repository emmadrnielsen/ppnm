set terminal svg size 900,600 background "white"
set output "hydrogen.svg"

set xlabel "r"
set ylabel "f(r)"
set title "Hydrogen ground-state wave function"
set grid

plot "hydrogen.data" using 1:2 with lines title "Numerical", \
     "hydrogen.data" using 1:3 with lines dashtype 2 title "Exact: r exp(-r)"